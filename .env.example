# HTTP server
PORT=3000
HOST=0.0.0.0
# Set to "true" only when running behind a reverse proxy on another machine.
TRUST_PROXY=loopback

# Storage
DATABASE_PATH=./data/uptime.db
MONITORS_FILE=monitors.json
BACKUP_DIR=./data/backups

# Admin dashboard protection (leave empty to run without authentication, e.g. on a private network).
# All three are required together. Generate the key with: openssl rand -base64 48
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_ENCRYPTION_KEY=

# Webhook notifications: discord, slack, telegram or generic. Empty URL disables webhooks.
WEBHOOK_PROVIDER=discord
WEBHOOK_URL=
WEBHOOK_HEADERS_JSON={}
WEBHOOK_TIMEOUT_MS=10000

# SSL certificate expiry warning window in days
SSL_EXPIRY_DAYS=30

# Optional SMTP email alerts (ALERT_FROM and ALERT_TO both required to enable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
